# Copy to backend.hcl (gitignored). Pre-existing NGWPC infra bucket
# (`ngwpc-infra-oe` matches nomad-runner's pattern for the Optimization
# account). Whether the bucket was LZA-created or pre-staged manually is
# unverified.
# State key follows NGWPC convention: terraform/{repo}/{env}/terraform.tfstate

bucket       = "ngwpc-infra-oe"
key          = "terraform/nwm-ngencerf-infra/optimization/ea/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
