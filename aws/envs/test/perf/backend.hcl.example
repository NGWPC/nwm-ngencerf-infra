# Copy to backend.hcl (gitignored). Pre-existing NGWPC infra bucket. Whether
# this bucket was LZA-created or pre-staged manually is unverified.
# State key follows NGWPC convention: terraform/{repo}/{env}/terraform.tfstate

bucket       = "ngwpc-infra-test"
key          = "terraform/nwm-ngencerf-infra/test/perf/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
