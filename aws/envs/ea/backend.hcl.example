# Copy to backend.hcl (gitignored). Pre-existing NGWPC infra bucket.
# State key follows NGWPC convention: terraform/{repo}/{env}/terraform.tfstate

bucket       = "ngwpc-infra-test"
key          = "terraform/nwm-ngencerf-infra/ea/terraform.tfstate"
region       = "us-east-1" # Region of the state S3 bucket (us-east-1 for NGWPC accounts)
encrypt      = true
use_lockfile = true
